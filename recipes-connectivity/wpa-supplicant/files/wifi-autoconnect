#!/bin/sh
### BEGIN INIT INFO
# Provides:          wifi-autoconnect
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Connect wlan0 using WPA and obtain a DHCP lease
### END INIT INFO
PATH=/sbin:/usr/sbin:/bin:/usr/bin
IFACE=wlan0
CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf

wpa_running() {
    wpa_cli -i "$IFACE" ping 2>/dev/null | grep -q '^PONG$'
}

dhcp_running() {
    for f in /run/dhcpcd/pid /run/dhcpcd/wlan0.pid /run/dhcpcd-wlan0.pid; do
        [ -r "$f" ] || continue
        p=$(cat "$f")
        case "$p" in ''|*[!0-9]*) continue ;; esac
        [ -r "/proc/$p/comm" ] || continue
        grep -q '^dhcpcd' "/proc/$p/comm" &&
            kill -0 "$p" 2>/dev/null && return 0
    done
    return 1
}

case "$1" in
start)
    [ -s "$CONF" ] || { echo "Missing WiFi configuration: $CONF" >&2; exit 1; }
    n=0
    while [ ! -d "/sys/class/net/$IFACE" ]; do
        n=$((n + 1))
        [ "$n" -lt 30 ] || { echo "$IFACE did not appear" >&2; exit 1; }
        sleep 1
    done
    ip link set "$IFACE" up || exit 1
    if ! wpa_running; then
        wpa_supplicant -B -i "$IFACE" -c "$CONF" -P /run/wpa_supplicant-wlan0.pid || exit 1
    fi
    # Background while waiting for carrier; keep running for lease renewal.
    # WPA is owned by this service, not dhcpcd's optional WPA hook.
    if ! dhcp_running; then
        dhcpcd -b -C wpa_supplicant "$IFACE" || exit 1
    fi
    echo "WiFi auto-connect and DHCP enabled on $IFACE"
    ;;
stop)
    dhcpcd -x "$IFACE" || true
    wpa_cli -i "$IFACE" terminate >/dev/null 2>&1 || true
    ;;
restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
status)
    wpa_cli -i "$IFACE" status
    ip -4 addr show dev "$IFACE"
    ip route show dev "$IFACE"
    dhcp_running || { echo 'dhcpcd is not running'; exit 1; }
    wpa_running || exit 1
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 2
    ;;
esac
