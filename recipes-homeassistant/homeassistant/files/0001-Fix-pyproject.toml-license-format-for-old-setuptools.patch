From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: meta-op3 <meta-op3@example.com>
Date: Wed, 16 Apr 2026 00:00:00 +0000
Subject: [PATCH] Fix pyproject.toml license format for setuptools <78

Upstream-Status: Inappropriate [older setuptools compat: PEP 639 format not supported until setuptools 78]

Setuptools <78 does not support the PEP 639 SPDX string format for license.
Change to the old dict format which is supported by all setuptools versions.

---
 pyproject.toml | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 1111111..2222222 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -5,8 +5,7 @@ version = "2026.2.0"
-license = "Apache-2.0"
-license-files = ["LICENSE*", "homeassistant/backports/LICENSE*"]
+license = {text = "Apache-2.0"}
 description = "Open-source home automation platform running on Python 3."
