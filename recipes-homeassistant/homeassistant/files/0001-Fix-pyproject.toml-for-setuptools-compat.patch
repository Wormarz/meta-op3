From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: meta-op3 <meta-op3@local>
Date: Thu, 16 Apr 2026 00:00:00 +0000
Subject: [PATCH] Fix pyproject.toml for setuptools <78 compatibility

Upstream-Status: Inappropriate [Yocto build compat: setuptools 76.x doesn't support
PEP 639 SPDX string license format nor exact version pin in build-system.requires]

setuptools < 78 requires the old dict format for license:
  license = {text = "..."}  instead of  license = "..."
Also remove the license-files field which is PEP 639 only.
Relax setuptools version pin to allow >= 76.0.0.

---
 pyproject.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 1111111..2222222 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["setuptools==78.1.1"]
+requires = ["setuptools>=76.0.0"]
 build-backend = "setuptools.build_meta"

 [project]
@@ -5,8 +5,7 @@
 [project]
 name = "homeassistant"
 version = "2026.2.0"
-license = "Apache-2.0"
-license-files = ["LICENSE*", "homeassistant/backports/LICENSE*"]
+license = {text = "Apache-2.0"}
 description = "Open-source home automation platform running on Python 3."
 readme = "README.rst"
 authors = [
